{
  "name": "roam-trip-planner",
  "version": "0.1.0",
  "private": true,
  "description": "A personal trip planner with editable itineraries, saved places, and notes.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/trips.test.ts",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
